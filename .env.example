# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored and blocked from the browser - never commit it.

# MySQL database credentials
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# Stripe sandbox keys (Dashboard -> Developers -> API keys, test mode)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# Optional: full URL of the public/ folder, used for Stripe's success/cancel
# redirects. Leave blank to detect it automatically.
# Example: http://localhost/ecommerce-project/public
APP_URL=

# Show the real error message on the checkout page while developing.
# Set to false before going live.
APP_DEBUG=true

# Gmail SMTP (use a Google App Password, never your regular Gmail password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ShopWave
