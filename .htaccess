Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep admin folder outside public
    RewriteRule ^admin(/.*)?$ - [L]

    # Send everything else to public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>